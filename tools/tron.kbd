; jzIntv kbdhackfile: the complete Xbox controller scheme for TRON Deadly Discs.
; Every controller input is bound here, so none of jzIntv's built-in joystick
; defaults apply.
;
;   Left stick   -> left controller disc (move)
;   Right stick  -> keyboard 1-9 via tools/right_stick.py (throw, 8 directions)
;   D-pad        -> right controller keypad 1-9 (throw)
;   A            -> right controller keypad 5 (block / duck)
;   Everything else (other buttons, triggers) -> nothing

MAP 0

; Left stick (JS0A) -> left disc
JS0A_E    PD0L_J_E
JS0A_ENE  PD0L_J_ENE
JS0A_NE   PD0L_J_NE
JS0A_NNE  PD0L_J_NNE
JS0A_N    PD0L_J_N
JS0A_NNW  PD0L_J_NNW
JS0A_NW   PD0L_J_NW
JS0A_WNW  PD0L_J_WNW
JS0A_W    PD0L_J_W
JS0A_WSW  PD0L_J_WSW
JS0A_SW   PD0L_J_SW
JS0A_SSW  PD0L_J_SSW
JS0A_S    PD0L_J_S
JS0A_SSE  PD0L_J_SSE
JS0A_SE   PD0L_J_SE
JS0A_ESE  PD0L_J_ESE

; Same stick under its unlettered name (jzIntv's built-in default uses JS0_*)
JS0_E     PD0L_J_E
JS0_ENE   PD0L_J_ENE
JS0_NE    PD0L_J_NE
JS0_NNE   PD0L_J_NNE
JS0_N     PD0L_J_N
JS0_NNW   PD0L_J_NNW
JS0_NW    PD0L_J_NW
JS0_WNW   PD0L_J_WNW
JS0_W     PD0L_J_W
JS0_WSW   PD0L_J_WSW
JS0_SW    PD0L_J_SW
JS0_SSW   PD0L_J_SSW
JS0_S     PD0L_J_S
JS0_SSE   PD0L_J_SSE
JS0_SE    PD0L_J_SE
JS0_ESE   PD0L_J_ESE

; Right stick (JS0B, --js0b in tron_build.py) -> nothing; tools/right_stick.py
; sends the throw keys instead (jzIntv's stick events jam keypad keys)
JS0B_E    NA
JS0B_ENE  NA
JS0B_NE   NA
JS0B_NNE  NA
JS0B_N    NA
JS0B_NNW  NA
JS0B_NW   NA
JS0B_WNW  NA
JS0B_W    NA
JS0B_WSW  NA
JS0B_SW   NA
JS0B_SSW  NA
JS0B_S    NA
JS0B_SSE  NA
JS0B_SE   NA
JS0B_ESE  NA

; D-pad -> right keypad
JS0_HAT0_N   PD0R_KP2
JS0_HAT0_NE  PD0R_KP3
JS0_HAT0_E   PD0R_KP6
JS0_HAT0_SE  PD0R_KP9
JS0_HAT0_S   PD0R_KP8
JS0_HAT0_SW  PD0R_KP7
JS0_HAT0_W   PD0R_KP4
JS0_HAT0_NW  PD0R_KP1

; Triggers (jzIntv auto-assigns them to JS0C) -> nothing
JS0C_E    NA
JS0C_ENE  NA
JS0C_NE   NA
JS0C_NNE  NA
JS0C_N    NA
JS0C_NNW  NA
JS0C_NW   NA
JS0C_WNW  NA
JS0C_W    NA
JS0C_WSW  NA
JS0C_SW   NA
JS0C_SSW  NA
JS0C_S    NA
JS0C_SSE  NA
JS0C_SE   NA
JS0C_ESE  NA

; Buttons: A = block, the rest -> nothing
JS0_BTN_00 PD0R_KP5
JS0_BTN_01 NA
JS0_BTN_02 NA
JS0_BTN_03 NA
JS0_BTN_04 NA
JS0_BTN_05 NA
JS0_BTN_06 NA
JS0_BTN_07 NA
JS0_BTN_08 NA
JS0_BTN_09 NA
JS0_BTN_10 NA
JS0_BTN_11 NA
JS0_BTN_12 NA
JS0_BTN_13 NA
JS0_BTN_14 NA
JS0_BTN_15 NA
