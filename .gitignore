# Only what is listed here is tracked: ROMs, BIOS, jzIntv, downloads, builds
# and personal settings stay out of the repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/launch_tron.bat
!/src/
!/tools/
__pycache__/
# Generated from your own ROM by tools/disasm.py (it is the whole game).
/src/tron.asm
